# ==========================================
# GateStory Environment Configuration
# ==========================================

# --- Ring Developer Credentials ---
# From Ring Developer Console -> Private Apps
RING_CLIENT_ID=your_client_id_here
RING_CLIENT_SECRET=your_client_secret_here
RING_HMAC_KEY=your_hmac_signature_key_here

# For Live Event History Polling & Simulator (valid for 30m in developer console)
RING_PLAYGROUND_TOKEN=your_playground_token_here
RING_DEVICE_ID=your_device_id_here

# --- AWS Configuration ---
# AWS account with hackathon credits
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# --- Bedrock & Features ---
# Set to true to enable Nova Lite/Micro enrichment behind feature flag
NOVA_ENRICHMENT_FLAG=false

# --- Server & Local Development ---
PORT=4321
NODE_ENV=development
